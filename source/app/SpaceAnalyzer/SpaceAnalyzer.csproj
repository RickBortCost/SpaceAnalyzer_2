<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Space Analyzer 3.0: local web service (UI API, analysis) hosting the acquisition and recording engine in-process. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SpaceAnalyzer</AssemblyName>
    <RootNamespace>SpaceAnalyzer.App</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Version>3.0.0</Version>
    <ApplicationIcon>../../static/space-analyzer.ico</ApplicationIcon>
    <Product>Space Analyzer</Product>
    <Description>Space Analyzer</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../engine/SpaceAnalyzer.Engine/SpaceAnalyzer.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.32" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
