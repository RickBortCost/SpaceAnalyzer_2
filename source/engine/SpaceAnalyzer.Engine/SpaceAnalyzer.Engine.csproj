<Project Sdk="Microsoft.NET.Sdk">
  <!-- Acquisition and recording engine of Space Fieldbus Analyzer 3.0: a child process of the UI service. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SpaceAnalyzer.Engine</AssemblyName>
    <RootNamespace>SpaceAnalyzer.Engine</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Version>3.4.0</Version>
    <ApplicationIcon>../../static/space-analyzer.ico</ApplicationIcon>
    <Product>Space Fieldbus Analyzer</Product>
    <Description>Space Fieldbus Analyzer acquisition and recording engine</Description>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ParquetSharp" Version="25.0.1.1" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="DotNetProjects.S7CommPlusDriver" Version="5.0.0" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.378.182" />
  </ItemGroup>
</Project>
